// Every relation in one place, grouped by the stage that drives it.

model {

  // ---- Importer stage -------------------------------------------------

  client -> kafka.importerCommands 'StartPreprocessingCommand'
  kafka.importerCommands -> toop.importer 'consumes command'
  toop.importer -> kafka.importerHeartbeat 'PreprocessHeartbeat per stage'
  toop.importer -> kafka.importerResults 'PreprocessingSuccessResult'

  unprocessedGridStore -> toop.importer.importStage 'raw grid file'
  toop.importer.importStage -> processedGrid.gridSnapshot 'normalized snapshot'
  toop.importer.importStage -> processedGrid.masks 'per-asset masks'
  toop.importer.importStage -> processedGrid.nminus1 'initial contingency set'
  toop.importer.importStage -> toop.importer.dcPreprocess 'ImportResult'

  toop.importer.dcPreprocess -> processedGrid.staticInfo 'PTDF, reduced dimensions, outage sets'
  toop.importer.dcPreprocess -> processedGrid.staticInfo.branchActionSet 'padded action arrays for the GPU'
  toop.importer.dcPreprocess -> processedGrid.actionSet 'the same actions as physical switchings'
  toop.importer.dcPreprocess -> processedGrid.nminus1 'refreshed contingency set'
  toop.importer.dcPreprocess -> toop.importer.initialLoadflow 'ready grid folder'

  toop.importer.initialLoadflow -> loadflowStore 'initial AC N-1 results'

  // Importer internals
  toop.importer.importStage.loadGrid -> toop.importer.importStage.whitelists 'parsed network'
  toop.importer.importStage.whitelists -> toop.importer.importStage.convergingParams 'scoped network'
  toop.importer.importStage.convergingParams -> toop.importer.importStage.networkMasks 'converging parameters'
  toop.importer.importStage.networkMasks -> toop.importer.importStage.topologyModel 'masks'

  toop.importer.dcPreprocess.bridges -> toop.importer.dcPreprocess.relevantNodes 'bridge flags'
  toop.importer.dcPreprocess.relevantNodes -> toop.importer.dcPreprocess.factors 'switchable subset'
  toop.importer.dcPreprocess.factors -> toop.importer.dcPreprocess.reduce 'PTDF / PSDF'
  toop.importer.dcPreprocess.reduce -> toop.importer.dcPreprocess.nminus2Filter 'reduced dimensions'
  toop.importer.dcPreprocess.nminus2Filter -> toop.importer.dcPreprocess.electricalActions 'disconnectable set D'
  toop.importer.dcPreprocess.electricalActions -> toop.importer.dcPreprocess.stationRealisations 'electrical splits'
  toop.importer.dcPreprocess.stationRealisations -> toop.importer.dcPreprocess.bbOutage 'action set A'

  // ---- DC optimization ------------------------------------------------

  client -> kafka.commands 'StartOptimizationCommand'
  kafka.commands -> toop.dcOptimizer 'consumes command'
  kafka.commands -> toop.acValidator 'consumes the same command'

  processedGrid.staticInfo -> toop.dcOptimizer 'loaded onto the GPU at startup'
  processedGrid.staticInfo.branchActionSet -> toop.dcOptimizer 'sampling space -- indices into these arrays'
  // The push to `results` is the epoch pusher's job specifically, declared
  // below with the rest of the optimizer internals.
  toop.dcOptimizer -> kafka.heartbeat 'OptimizationStatsHeartbeat'

  toop.dcOptimizer.repertoire -> toop.dcOptimizer.mutation 'sampled elites'
  toop.dcOptimizer.repertoire -> toop.dcOptimizer.crossover 'sampled pairs'
  toop.dcOptimizer.mutation -> toop.dcOptimizer.dcSolver 'candidate batch'
  toop.dcOptimizer.crossover -> toop.dcOptimizer.dcSolver 'candidate batch'
  toop.dcOptimizer.dcSolver -> toop.dcOptimizer.scoring 'N-0 and N-1 flows'
  toop.dcOptimizer.scoring -> toop.dcOptimizer.repertoire 'fitness and descriptors, sorted insert'
  toop.dcOptimizer.repertoire -> toop.dcOptimizer.pusher 'new elites'
  toop.dcOptimizer.pusher -> kafka.results 'TopologyPushResult per epoch'

  toop.dcOptimizer.dcSolver.bsdfStage -> toop.dcOptimizer.dcSolver.n0Stage 'updated PTDF, LODF, MODF, static flows'
  toop.dcOptimizer.dcSolver.n0Stage -> toop.dcOptimizer.dcSolver.n1Stage 'N-0 flows and nodal injections'
  toop.dcOptimizer.dcSolver.n1Stage -> toop.dcOptimizer.dcSolver.resultExtraction 'N-1 matrix'

  // ---- AC validation --------------------------------------------------

  processedGrid.gridSnapshot -> toop.acValidator 'base grid'
  processedGrid.actionSet -> toop.acValidator 'to realize topologies'

  // The AC-Validator is the main producer here, not a consumer: every topology
  // it evaluates has its loadflow results persisted and referenced by handle.
  // It only reads back the initial loadflow as a comparison baseline -- and
  // even that it computes and stores itself when none was passed in.
  toop.acValidator -> loadflowStore 'AC loadflow results per evaluated topology'
  loadflowStore -> toop.acValidator 'initial loadflow as baseline'

  kafka.results -> toop.acValidator.resultListener 'DC topologies'
  toop.acValidator.resultListener -> toop.acValidator.selectStrategy 'candidate pool'
  toop.acValidator.selectStrategy -> toop.acValidator.worstK 'selected batch'
  toop.acValidator.worstK -> toop.acValidator.remainingCa 'survivors'
  toop.acValidator.worstK -> toop.acValidator.acceptance 'worst-k results'
  toop.acValidator.remainingCa -> toop.acValidator.acceptance 'full N-1 results'
  toop.acValidator.acceptance -> toop.acValidator.summaryWriter 'accepted topologies'

  toop.acValidator.selectStrategy.discriminator -> toop.acValidator.selectStrategy.dominator 'survivors'
  toop.acValidator.selectStrategy.dominator -> toop.acValidator.selectStrategy.median 'survivors'

  toop.acValidator -> kafka.results 'AC-validated Strategy'
  toop.acValidator -> kafka.heartbeat 'OptimizationStatsHeartbeat'
  toop.acValidator.summaryWriter -> processedGrid.snapshots 'summaries and diagrams'

  // ---- Contingency analysis -------------------------------------------

  toop.importer.initialLoadflow -> toop.contingency.dispatcher 'base grid N-1'
  toop.acValidator.worstK -> toop.contingency.dispatcher 'worst-k contingencies'
  toop.acValidator.remainingCa -> toop.contingency.dispatcher 'full N-1'

  toop.contingency.dispatcher -> toop.contingency.ppCa 'if pandapowerNet'
  toop.contingency.dispatcher -> toop.contingency.pwCa 'if PyPowSyBl Network'

  toop.contingency.ppCa.ppOutageGrouping -> toop.contingency.ppCa.ppSlack 'grouped contingencies'
  toop.contingency.ppCa.ppSlack -> toop.contingency.ppCa.ppSpps 'solvable islands'
  toop.contingency.ppCa.ppSpps -> toop.contingency.ppCa.ppCascade 'post-scheme state'

  toop.contingency.ppCa -> toop.interfaces.lfResults 'fills all nine tables'
  toop.contingency.pwCa -> toop.interfaces.lfResults 'fills the five common tables'

  toop.interfaces.lfResults -> loadflowStore 'persisted per job'

  // ---- Asset topology --------------------------------------------------

  toop.importer.importStage.topologyModel -> toop.interfaces.assetTopo 'built from the node-breaker model'
  toop.interfaces.assetTopo -> toop.importer.dcPreprocess.electricalActions 'stations to enumerate splits for'
  toop.importer.dcPreprocess.stationRealisations -> toop.interfaces.storedActionSet 'physical switchings per action'
  toop.interfaces.assetTopo -> toop.interfaces.storedActionSet 'reference topology'

  toop.interfaces.storedActionSet -> toop.postprocess.realize 'action to realize'
  toop.postprocess.realize -> toop.postprocess.applyPp 'realized topology'
  toop.postprocess.realize -> toop.postprocess.applyPw 'realized topology'
  toop.postprocess.realize -> toop.interfaces.switchUpdate 'switch id and new state'

  toop.postprocess.applyPp -> toop.contingency.ppCa 'grid with topology applied'
  toop.postprocess.applyPw -> toop.contingency.pwCa 'grid with topology applied'
  toop.postprocess.applyPw -> toop.postprocess.sldExport 'modified network'

  toop.interfaces.switchUpdate -> toop.postprocess.dgsExport 'switch list'
  toop.interfaces.switchUpdate -> toop.postprocess.ucteExport 'switch list'
  toop.acValidator.summaryWriter -> toop.interfaces.switchUpdate 'accepted topology'

  toop.postprocess.dgsExport -> processedGrid.snapshots 'DGS tables (.dgs / .xlsx)'
  toop.postprocess.ucteExport -> processedGrid.snapshots 'UCTE file'
  toop.postprocess.sldExport -> processedGrid.snapshots 'single line diagrams (.svg)'

  toop.interfaces.backendAbstraction -> toop.importer.dcPreprocess 'grid as flat arrays'
  toop.interfaces.nminus1Def -> toop.contingency.dispatcher 'monitored elements and contingencies'

  // ---- Consumption ----------------------------------------------------

  kafka.results -> downstream 'validated topologies for review'
  processedGrid.snapshots -> downstream 'UCTE, DGS, OpenRAO summaries, single line diagrams'

  // ---- Parameters -------------------------------------------------------

  // Deliberately one arrow per stage. Which sub-object reaches which internal
  // component is real but not interesting at this level, and drawing it turns
  // every stage view into a hairball.

  client -> toop.importerParams 'set in StartPreprocessingCommand'
  client -> toop.dcParams 'set in StartOptimizationCommand'
  client -> toop.acParams 'set in the same StartOptimizationCommand'

  toop.importerParams -> toop.importer 'scope, limits, contingencies'
  toop.dcParams -> toop.dcOptimizer 'search bounds, fitness, operator probabilities'
  toop.acParams -> toop.acValidator 'compute budget, pruning, rejection thresholds'
}

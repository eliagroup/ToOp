// For engineers working on the importer.

views {

  view importerInternals of toop.importer {
    title 'Importer -- what happens to a grid file'
    description '
      For working on the importer. Two chains and a measurement. convert_file
      turns a raw file into a converging, masked backend snapshot; the DC
      preprocessing chain shrinks the problem and enumerates the action space
      the optimizer will sample from; the initial AC loadflow fixes the
      reference the whole run is judged against.

      Most of this depends only on the initial grid topology, so it can run
      before the forecast arrives -- which matters, because CGMES parsing alone
      dominates the importer runtime.
    '

    include *,
      toop.importer.importStage.*,
      toop.importer.dcPreprocess.*,
      unprocessedGridStore,
      unprocessedGridStore.inputNminus1,
      processedGrid,
      processedGrid.staticInfo,
      processedGrid.staticInfo.branchActionSet,
      processedGrid.actionSet,
      processedGrid.gridSnapshot,
      processedGrid.assetTopoMaster,
      processedGrid.masks,
      processedGrid.nminus1,
      processedGrid.dcNminus1,
      loadflowStore

    // The shared packages pull the preprocessing chain out of sequence: their
    // incoming edges rank it ahead of convert_file, which then reads as though
    // it ran second. The two stages are strictly sequential, so keep the only
    // ordering signal the ImportResult handover between them.
    exclude toop.interfaces,
      toop.contingency,
      toop.postprocess

    autoLayout TopBottom

    style * {
      color muted
    }
    style toop.importer.importStage, toop.importer.importStage.* {
      color primary
    }
    style toop.importer.dcPreprocess, toop.importer.dcPreprocess.* {
      color indigo
    }
    style toop.importer.initialLoadflow {
      color red
    }
  }

  view nminus1Journeys of toop.importer {
    title 'Importer -- how the N-1 definition is built'
    description '
      The two journeys that produce nminus1_definition.json, in the same order:
      source, area settings, three-winding transformer conversion.

      Journey A (magenta) starts from an optional input N-1 definition and
      treats it as authoritative. It is validated against the grid before the
      3W conversion, network reduction keeps all of its voltage levels, and it
      is checked against the processed grid once more at the end.

      Journey B (orange) has no input file and derives the definition from the
      network masks, which apply the area settings.

      Both journeys end in a definition whose element ids all exist in the
      processed grid, with 3W transformers as their three legs. The initial AC
      loadflow reads it as-is, while DC preprocessing writes its own
      dc_nminus1_definition.json next to it.
    '

    include unprocessedGridStore,
      unprocessedGridStore.inputNminus1,
      toop.importer.importStage,
      toop.importer.importStage.loadGrid,
      toop.importer.importStage.inputValidation,
      toop.importer.importStage.trafoConversion,
      toop.importer.importStage.networkReduction,
      toop.importer.importStage.whitelists,
      toop.importer.importStage.convergingParams,
      toop.importer.importStage.networkMasks,
      toop.importer.importStage.nminus1Definition,
      toop.importer.importStage.nminus1Definition.*,
      toop.importer.dcPreprocess,
      toop.importer.initialLoadflow,
      processedGrid,
      processedGrid.nminus1,
      processedGrid.dcNminus1

    exclude toop.interfaces,
      toop.contingency,
      toop.postprocess

    autoLayout TopBottom

    style * {
      color muted
    }
    style toop.importer.importStage, toop.importer.importStage.*, toop.importer.importStage.nminus1Definition.* {
      color slate
    }
    style element.tag = #journeyA {
      color secondary
    }
    style element.tag = #journeyB {
      color amber
    }
    style toop.importer.importStage.nminus1Definition.convertTrafo3w, toop.importer.importStage.trafoConversion {
      color primary
    }
    style toop.importer.dcPreprocess {
      color indigo
    }
    style toop.importer.initialLoadflow {
      color red
    }
  }

  // =====================================================================
  // 4. Engineer -- the DC-Optimizer
  // =====================================================================
}

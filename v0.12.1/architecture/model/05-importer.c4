// Stage 1: raw grid file to solver artifacts.

model {
  extend toop {

    importer = worker 'Importer' {
      #cpu
      link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.worker.worker 'worker'
      technology 'Python, PyPowSyBl, pandapower, JAX'
      description '
        Normalizes a raw grid into a processed grid folder and derives the
        solver artifacts. Most of it depends only on the initial grid topology,
        so it can run before the forecast is available. Runs one job at a time.
      '

      importStage = stage 'convert_file' {
        link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.pypowsybl_import.preprocessing.convert_file 'convert_file'
        technology 'PyPowSyBl / pandapower'
        description 'Raw grid file to a normalized, converging backend snapshot.'

        loadGrid = component 'Load and merge' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.pypowsybl_import.preprocessing.convert_file 'convert_file'
          description 'Parse UCTE/CGMES/PowerFactory. Dominates importer runtime on CGMES.'
        }
        whitelists = component 'Apply whitelists' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.pypowsybl_import.preprocessing.convert_file 'convert_file'
          description 'Apply the CB / black- and whitelists that scope the switchable area.'
        }
        convergingParams = component 'find_converging_loadflow_params' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.pypowsybl_import.preprocessing.find_converging_loadflow_params 'find_converging_loadflow_params'
          description '
            Sweep loadflow parameters and voltage init methods until the base
            case converges. Some grid files do not converge on defaults.
          '
        }
        networkMasks = component 'get_network_masks' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.pypowsybl_import.preprocessing.get_network_masks 'get_network_masks'
          description 'Build the per-asset masks, then derive the initial N-1 definition from them.'
        }
        topologyModel = component 'get_master_asset_topology_artifact' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.pypowsybl_import.preprocessing.get_master_asset_topology_artifact 'get_master_asset_topology_artifact'
          description '
            Extraction. Dispatches on the importer data_type and hands off to
            one of the readers below -- which is the whole reason the rest of
            the engine never has to know which framework parsed the file.
          '

          busBreakerExtract = component 'get_bus_breaker_master_asset_topology' {
            #powsyblOnly
            link https://eliagroup.github.io/ToOp/latest/references/reference_grid_helpers/#toop_engine_grid_helpers.powsybl.powsybl_asset_topo.get_bus_breaker_master_asset_topology 'get_bus_breaker_master_asset_topology'
            description 'UCTE. Bus-breaker source, so bays and busbars have to be inferred rather than read.'
          }
          nodeBreakerExtract = component 'get_node_breaker_master_asset_topology' {
            #powsyblOnly
            link https://eliagroup.github.io/ToOp/latest/references/reference_grid_helpers/#toop_engine_grid_helpers.powsybl.powsybl_station_to_graph.get_node_breaker_master_asset_topology 'get_node_breaker_master_asset_topology'
            description 'CGMES. Node-breaker source, walked as a station graph -- the richest input, and the one the model is shaped after.'
          }
          ppExtract = component 'get_master_asset_topology_from_network' {
            #pandapowerOnly
            link https://eliagroup.github.io/ToOp/latest/references/reference_grid_helpers/#toop_engine_grid_helpers.pandapower.asset_topology.get_master_asset_topology_from_network 'get_master_asset_topology_from_network'
            description 'pandapower nets, read through the pandapower switch and bus tables.'
          }
        }
      }

      dcPreprocess = stage 'load_grid (DC preprocessing)' {
        link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.convert_to_jax.load_grid 'load_grid'
        technology 'JAX, NumPy'
        description '
          A chain of NetworkData transforms that shrinks the problem and
          enumerates the action space. This is where the linearized DC
          representation is built.
        '

        materialize = component 'get_runtime_asset_topology' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_interfaces/#toop_engine_interfaces.backend.BackendInterface.get_runtime_asset_topology 'get_runtime_asset_topology'
          description '
            Transition 1. Reads the master data back and materializes it against
            the loaded network: structure from the importer artifact, switch and
            busbar states from the grid file. Backend-specific, and it refuses
            to continue if the live state comes out narrower than the
            connectivity the master data declared -- silently losing a possible
            busbar assignment here would silently shrink the action space later.

            Worth knowing that the two inputs are separable by construction
            rather than by accident: structure arrives as a MasterAssetTopology
            and live state as a compact RuntimeSwitchingState overlay, through
            separate parameters, and neither reader reaches back for the other.
            Today both are read from the same normalized snapshot, so the seam
            is invisible -- but nothing here requires one file, and a case
            derived elsewhere (outages in force, concrete nodal injections)
            would enter exactly here, against unchanged master structure.
          '

          pwMaterialize = component 'materialize_runtime_bus_groups_from_network_state' {
            #powsyblOnly
            link https://eliagroup.github.io/ToOp/latest/references/reference_grid_helpers/#toop_engine_grid_helpers.powsybl.powsybl_asset_topo.materialize_runtime_bus_groups_from_network_state 'materialize_runtime_bus_groups_from_network_state'
            description 'Reads switch positions straight off the node-breaker network, station by station.'
          }
          compactMaterialize = component 'materialize_runtime_bus_group_from_runtime_state' {
            link https://eliagroup.github.io/ToOp/latest/references/reference_interfaces/#toop_engine_interfaces.asset_topology.topology_conversion.materialize_runtime_bus_group_from_runtime_state 'materialize_runtime_bus_group_from_runtime_state'
            description '
              The backend-neutral half: a canonical bus group plus a compact
              RuntimeSwitchingState overlay in, one runtime bus group out. The
              pandapower path runs through here, and so does the PyPowSyBl
              fallback for legacy bay-less stations.
            '
          }
        }
        bridges = component 'compute_bridging_branches' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess.compute_bridging_branches 'compute_bridging_branches'
          description '
            Tarjan bridge finding. A branch whose removal islands the grid,
            under N-0 or any contingency, cannot be disconnected.
          '
        }
        relevantNodes = component 'filter_relevant_nodes' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess.filter_relevant_nodes_branch_count 'filter_relevant_nodes_branch_count'
          description '
            Drop substations that are not worth switching: too few branches,
            no assets, or double connections.
          '
        }
        factors = component 'compute PTDF / PSDF' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess.compute_ptdf_if_not_given 'compute_ptdf_if_not_given'
          description '
            The reference PTDF matrix, solved once. Every topology the optimizer
            later evaluates is a low-rank update of it rather than a refactorization.
          '
        }
        reduce = component 'reduce node / branch dimension' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess.reduce_branch_dimension 'reduce_branch_dimension'
          description '
            Collapse nodes that never change into a single static column and
            drop branches that are neither monitored, outaged nor switched.
            Directly shrinks the PTDF the GPU has to hold.
          '
        }
        nminus2Filter = component 'filter_disconnectable_branches_nminus2' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess.filter_disconnectable_branches_nminus2 'filter_disconnectable_branches_nminus2'
          description 'Exclude branches that island the grid in combination with a contingency.'
        }
        simplify = component 'simplify_asset_topology' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess.simplify_asset_topo_of_splittable_buses 'simplify_asset_topo_of_splittable_buses'
          description '
            Transition 2. Projects each relevant station onto one electrical
            node at a time and runs prepare_for_separation_set on the slice.
            Stations that survive become the simplified topology; the ones that
            do not are removed from the relevant set here rather than failing
            the run.

            Runs late, after the dimension reductions, because it needs the
            final branch and injection ordering to project onto. Busbar-outage
            preprocessing runs the same reduction a second time with couplers
            forced closed, for a separate view of its own.
          '

          prepareSeparation = component 'prepare_for_separation_set' {
            link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess_switching.prepare_for_separation_set 'prepare_for_separation_set'
            description '
              Where the reduction actually happens, one bus group at a time:
              order assets to the solver index order, drop out-of-service assets
              and disconnected busbars, remove duplicate open couplers, fuse
              disconnector couplers, and pick one bus for assets hanging off
              several. Each step is best-effort and reports what it had to fix.
            '
          }
          bbSimplify = component 'simplify_asset_topology_for_bb_outages' {
            link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.simplify_topology.simplify_asset_topology_for_bb_outages 'simplify_asset_topology_for_bb_outages'
            description '
              The second reduction, for busbar-outage preprocessing, run with
              couplers forced closed. Yields a separate simplified topology
              rather than replacing the first one.
            '
          }
        }
        electricalActions = component 'compute_electrical_actions' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess_switching 'preprocess_switching'
          description '
            Stage one of action set enumeration: every electrically distinct
            two-node split of a station, filtered for islanding and
            connectivity, clipped if a station exceeds the configured limit.
          '
        }
        stationRealisations = component 'enumerate_station_realisations' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess_station_realisations 'preprocess_station_realisations'
          description '
            Stage two: map each electrical split onto a reachable node-breaker
            realization and precompute its reassignment distance. Splits with
            no valid realization are discarded.
          '
        }
        bbOutage = component 'preprocess_bb_outage' {
          link https://eliagroup.github.io/ToOp/latest/references/reference_dc_solver/#toop_engine_dc_solver.preprocess.preprocess_bb_outage 'preprocess_bb_outage'
          description 'Optional busbar outage contingencies, used by the do-not-make-it-worse criterion.'
        }
      }

      initialLoadflow = stage 'run_initial_loadflow' {
        #ac
        link https://eliagroup.github.io/ToOp/latest/references/reference_importer/#toop_engine_importer.worker.preprocessor.run_initial_loadflow 'run_initial_loadflow'
        technology 'PyPowSyBl'
        description '
          Full AC N-1 on the unmodified grid. Produces the reference metrics
          every proposed topology is later compared against.
        '
      }
    }
  }
}

// Everything outside the engine: who drives it, what goes in, what comes out.

model {

  client = actor 'Operator / orchestration client' {
    description '
      Drives the engine either directly from Python or by producing Kafka
      commands. ToOp ships no GUI or system integration of its own.
      In operational use the whole run must finish inside a 15 minute window,
      because topology measures have to be fixed before redispatch planning.
    '
  }



  downstream = externalSystem 'Frontend / downstream systems' {
    description '
      Where an operator reviews the proposed actions and exports the accepted
      ones. Not part of this repository.
    '
  }
}
